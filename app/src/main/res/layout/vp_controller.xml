<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/controller_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<!-- Top bar for fullscreen video title -->
	<LinearLayout
		android:id="@+id/top_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="top"
		android:background="@drawable/bg_controller_top_gradient"
		android:gravity="center"
		android:paddingStart="16dp"
		android:paddingTop="12dp"
		android:paddingEnd="16dp"
		android:paddingBottom="16dp"
		android:visibility="gone">

		<TextView
			android:id="@+id/video_title_fullscreen"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="1"
			android:shadowColor="#FF000000"
			android:shadowDx="1.5"
			android:shadowDy="1.5"
			android:shadowRadius="3.0"
			android:textColor="#FFFFFFFF"
			android:textSize="16sp"
			android:textStyle="bold" />
	</LinearLayout>

	<!-- Right-side volume container -->
	<FrameLayout
		android:id="@+id/sound_container"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="end|center_vertical"
		android:layout_marginEnd="16dp"
		android:background="@drawable/bg_sound_panel"
		android:padding="8dp"
		android:visibility="gone">

		<com.perez.media.SoundView
			android:id="@+id/sound_view"
			android:layout_width="44dp"
			android:layout_height="180dp" />
	</FrameLayout>

	<!-- Bottom controller bar -->
	<LinearLayout
		android:id="@+id/bottom_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom"
		android:background="@drawable/bg_controller_bottom_gradient"
		android:orientation="vertical"
		android:paddingStart="16dp"
		android:paddingTop="12dp"
		android:paddingEnd="16dp"
		android:paddingBottom="12dp">

		<!-- Progress bar row -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<TextView
				android:id="@+id/has_played"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="00:00:00"
				android:textColor="#E0E0E0"
				android:textSize="12sp" />

			<SeekBar
				android:id="@+id/seekbar"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="8dp"
				android:layout_marginEnd="8dp"
				android:layout_weight="1"
				android:maxHeight="4dp"
				android:progressDrawable="@drawable/custom_seekbar_progress"
				android:thumb="@drawable/custom_seekbar_thumb" />

			<TextView
				android:id="@+id/duration"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="00:00:00"
				android:textColor="#E0E0E0"
				android:textSize="12sp" />
		</LinearLayout>

		<!-- Buttons row -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:gravity="center"
			android:orientation="horizontal">

			<ImageButton
				android:id="@+id/button3"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:layout_marginEnd="24dp"
				android:background="?android:attr/selectableItemBackgroundBorderless"
				android:scaleType="fitCenter"
				android:src="@drawable/play" />

			<ImageButton
				android:id="@+id/button5"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:layout_marginStart="24dp"
				android:background="?android:attr/selectableItemBackgroundBorderless"
				android:scaleType="fitCenter"
				android:src="@drawable/soundenable" />
		</LinearLayout>
	</LinearLayout>

</FrameLayout>